# =============================================================================
# MedRAG — environment template (safe to commit)
#
#   cp .env.example .env
#
# The real file ".env" is gitignored. Never commit secrets. Revoke any API key
# that has appeared in git history, logs, or chat.
#
# ------------------------------------------------------------------------------
# How DATABASE_URL / REDIS_URL are used
#
# - uvicorn on your laptop (no Docker): values below must point at Postgres and
#   Redis reachable from the host (127.0.0.1 if you use docker compose and
#   publish ports 5432 / 6379).
#
# - API in docker-compose.dev.yml: compose OVERRIDES DATABASE_URL and REDIS_URL
#   for the api service to use the Docker service hostnames `postgres` and
#   `redis`. You still use this file for Pinecone, OpenAI, JWT, etc.
# =============================================================================

# --- Local data stores (host-resolved URLs for bare-metal uvicorn) -----------
# Credentials must match docker-compose.dev.yml postgres.* unless you change both.
POSTGRES_USER=medrag
POSTGRES_PASSWORD=medrag
POSTGRES_DB=medrag
DATABASE_URL=postgresql://medrag:medrag@127.0.0.1:5432/medrag
REDIS_URL=redis://127.0.0.1:6379/0

# --- Vector store (Pinecone integrated index) ---------------------------------
# Use mock-dev for in-memory store (no billable Pinecone calls).
#
# Integrated index: Pinecone embeds text; set PINECONE_TEXT_FIELD to the field
# name in your index "field map" (Pinecone console → index → configuration).
#
# PINECONE_API_KEY=
PINECONE_API_KEY=mock-dev
PINECONE_INDEX=your-index-name
PINECONE_NAMESPACE=__default__
PINECONE_TEXT_FIELD=text

# --- LLM ----------------------------------------------------------------------
# llm_provider=openai uses OPENAI_API_KEY when it is not a placeholder.
# Placeholder keys (mock-dev, empty) → mock LLM with canned answers (no spend).
LLM_PROVIDER=openai
OPENAI_API_KEY=mock-dev
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=mock-dev

# --- Auth (JWT) ----------------------------------------------------------------
# HS256: use at least 32 random bytes. Example:
#   openssl rand -base64 32
JWT_SECRET_KEY=replace-with-openssl-rand-base64-32-bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
