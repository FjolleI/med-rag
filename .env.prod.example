# =============================================================================
# Production (EC2 / VM) — copy to ".env" on the server only
#
#   cp .env.prod.example .env && ${EDITOR:-vi} .env && ./deploy/deploy.sh
#
# Never commit .env. Generate DOMAIN after you know the instance public IP
# (sslip.io) or use a DNS name you control.
# =============================================================================

DOMAIN=CHANGE-ME.sslip.io

# Required secrets (see deploy/deploy.sh validation)
JWT_SECRET_KEY=CHANGE-ME-openssl-rand-base64-32-bytes-minimum
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password

# docker-compose.prod.yml injects DATABASE_URL / REDIS_URL for the api service
# using POSTGRES_PASSWORD above. Do not point DATABASE_URL at localhost there.

# --- Pinecone (integrated index) ---------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=your-index-name
PINECONE_NAMESPACE=__default__
PINECONE_TEXT_FIELD=text

# --- LLM -----------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=mock-dev

JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
ENVIRONMENT=production
LOG_LEVEL=INFO
